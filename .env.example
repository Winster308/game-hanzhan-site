# ===== 游戏汉化站 环境变量示例 =====
# 复制为 .env 后按需修改（本地开发用）

# API 服务
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/game_hanzhan
JWT_SECRET=请更换为随机长字符串
# 管理员初始密码（seed 时创建 Winster/winster 账号使用）
ADMIN_PASSWORD=Winster@2025

# 邮件（优先 SMTP，其次 Brevo；都不配置则仅打日志）
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com SMTP_PORT=465 SMTP_USER=<你的qq邮箱> SMTP_PASS=<QQ邮箱授权码>
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
BREVO_API_KEY=
MAIL_FROM=游戏汉化站 <no-reply@example.com>
WEB_URL=http://localhost:5173

# 前端（构建时注入，留空则同源 /api；生产建议留空走 nginx 代理）
# VITE_API_URL=

# nginx 代理目标（web / admin 服务的环境变量，指向 API 服务地址）
# API_UPSTREAM=http://api服务域名
